APP_NAME="LAV SMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# ============================================================
# SUPABASE DATABASE  (IPv4 POOLER - REQUIRED)
# ============================================================
# The direct host db.<ref>.supabase.co is IPv6-ONLY.
# Most home/office networks in Pakistan are IPv4-only, which is why
# it failed with: "could not translate host name ... Unknown host".
#
# These pooler settings are IPv4 and are the CORRECT ones for this project.
# Verified cluster: aws-0-ap-southeast-1 (54.255.219.82)
#
# NOTE: the username is postgres.<project-ref>  -- NOT plain "postgres".
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.mslydvabhamtjltuseno
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD_HERE
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# SUPABASE API (optional - not needed for the Laravel app)
# ============================================================
SUPABASE_URL=https://mslydvabhamtjltuseno.supabase.co
